APP_ENV=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://mimicmotion:mimicmotion_local@localhost:5432/mimicmotion
WEB_ALLOWED_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
AUTH_TOKEN_PEPPER=replace-with-at-least-32-random-bytes
SESSION_COOKIE_NAME=mm_session
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_IDLE_TTL_SECONDS=604800
SESSION_ABSOLUTE_TTL_SECONDS=2592000
CSRF_COOKIE_NAME=mm_csrf
CSRF_COOKIE_SECURE=false
CSRF_COOKIE_SAMESITE=lax
PASSWORD_MIN_LENGTH=12
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=mimicmotion-local
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin-local
S3_FORCE_PATH_STYLE=true
S3_PRESIGNED_UPLOAD_TTL_SECONDS=900
S3_PRESIGNED_DOWNLOAD_TTL_SECONDS=300
READY_CHECK_STORAGE=true
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_API_BASE_URL=https://api.runpod.ai/v2
RUNPOD_REQUEST_TIMEOUT_SECONDS=30
RUNPOD_WEBHOOK_TOKEN=replace-with-a-long-random-provider-webhook-token
RUNPOD_WEBHOOK_URL=https://api.example.com/api/v1/webhooks/runpod?token=replace-with-the-same-random-provider-webhook-token
RUNPOD_WEBHOOK_MAX_BODY_BYTES=1048576
RUNPOD_WEBHOOK_LEASE_SECONDS=60
MAX_GENERATION_ATTEMPTS=2
MAX_ACTIVE_GENERATIONS_PER_USER=2
MAX_DAILY_GENERATIONS_PER_USER=20
GENERATION_OUTPUT_PURGE_DELAY_SECONDS=3600
GENERATION_SIGNED_URL_TTL_SECONDS=7200
GENERATION_LEASE_SECONDS=60
GENERATION_POLL_SECONDS=5
MAX_GENERATED_OUTPUT_BYTES=209715200
MAX_PORTRAIT_UPLOAD_BYTES=15728640
MAX_MOTION_UPLOAD_BYTES=104857600
DEFAULT_STORAGE_QUOTA_BYTES=1073741824
PORTRAIT_MIN_DIMENSION=512
PORTRAIT_MAX_DIMENSION=8192
PORTRAIT_MAX_PIXELS=40000000
MOTION_MIN_DURATION_MS=5000
MOTION_MAX_DURATION_MS=15000
MOTION_MAX_DIMENSION=4096
MEDIA_VALIDATION_TIMEOUT_SECONDS=60
MEDIA_VALIDATION_LEASE_SECONDS=300
MEDIA_VALIDATION_MAX_ATTEMPTS=3
MEDIA_VALIDATION_BATCH_SIZE=4
MEDIA_VALIDATION_POLL_SECONDS=5
